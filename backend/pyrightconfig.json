{
  "include": [
    "backend/app",
    "backend/tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.pytest_cache",
    "backend/venv",
    "backend/.venv",
    "backend/var"
  ],
  "venvPath": "backend",
